{
  "name": "marina",
  "version": "1.0.0",
  "description": "Transparent desktop VRM avatar assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir",
    "dmg": "electron-builder --mac"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "three": "^0.185.1"
  },
  "productName": "Marina",
  "build": {
    "appId": "com.jacobmatthews.marina",
    "productName": "Marina",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "models/**/*",
      "assets/**/*",
      "!test/**",
      "!src/**",
      "!build/**"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Marina uses the microphone so you can talk to her.",
        "LSUIElement": false,
        "NSDesktopFolderUsageDescription": "Marina needs to read her Python backend and avatar model from this folder.",
        "NSDocumentsFolderUsageDescription": "Marina needs to read her Python backend and avatar model from this folder.",
        "NSDownloadsFolderUsageDescription": "Marina needs to read her Python backend and avatar model from this folder.",
        "NSAppleEventsUsageDescription": "Marina controls other apps on this Mac when you let her, to work on what's on your screen."
      }
    },
    "dmg": {
      "title": "Marina",
      "artifactName": "Marina-${version}-arm64.dmg",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "author": "Jacob Matthews"
}
